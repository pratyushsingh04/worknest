# Local dev DB (started by `npm run db:start`)
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/worknest"
JWT_SECRET="change-me-to-a-long-random-string"
PORT=4000
CLIENT_ORIGIN="http://localhost:3000"
NODE_ENV=development

# The real owner account. `npm run db:seed` makes this person the founder/admin of the
# workspace and the platform owner, then prints a one-time link to set their password.
ADMIN_EMAIL=""
ADMIN_NAME=""
COMPANY_NAME=""

# Email (optional). Without SMTP_HOST, emails are saved to Admin console → Emails instead.
# Gmail example: SMTP_HOST=smtp.gmail.com SMTP_PORT=465 SMTP_SECURE=true
#   SMTP_USER=you@gmail.com SMTP_PASS=<16-char Google App Password>
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="WorkNest <no-reply@worknest.local>"
