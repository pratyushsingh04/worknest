generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  EMPLOYEE
  CLIENT
}

enum AttendanceStatus {
  PRESENT
  LATE
}

enum LeaveType {
  CASUAL
  SICK
  EARNED
  UNPAID
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
}

enum MilestoneStatus {
  PENDING
  IN_PROGRESS
  AWAITING_APPROVAL
  APPROVED
  CHANGES_REQUESTED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// A tenant. Every other row belongs to exactly one company.
model Company {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  timezone      String   @default("Asia/Kolkata")
  workStartTime String   @default("10:00") // HH:mm, used to mark late check-ins
  officeLat     Float?
  officeLng     Float?
  officeRadiusM Int      @default(200)
  createdAt     DateTime @default(now())

  users      User[]
  clients    Client[]
  projects   Project[]
  attendance Attendance[]
  leaves     Leave[]
  activities Activity[]
  invites    Invite[]
  logins     LoginEvent[]
  emails     EmailLog[]
  teams      Team[]
  requests   ServiceRequest[]
}

model User {
  id              String    @id @default(cuid())
  companyId       String
  name            String
  email           String    @unique
  passwordHash    String
  role            Role
  designation     String?
  department      String?
  phone           String?
  isActive        Boolean   @default(true)
  joinedAt        DateTime  @default(now())
  managerId       String?
  clientId        String? // set only for CLIENT users
  lastLoginAt     DateTime?
  // Owner of the WorkNest platform itself (sees every company). Never set via the API.
  isPlatformAdmin Boolean   @default(false)
  createdAt       DateTime  @default(now())

  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  manager         User?            @relation("Reports", fields: [managerId], references: [id], onDelete: SetNull)
  reports         User[]           @relation("Reports")
  client          Client?          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  managedProjects Project[]        @relation("ProjectManager")
  memberships     ProjectMember[]
  assignedTasks   Task[]           @relation("TaskAssignee")
  attendance      Attendance[]
  leaves          Leave[]          @relation("LeaveApplicant")
  reviewedLeaves  Leave[]          @relation("LeaveReviewer")
  activities      Activity[]
  comments        Comment[]
  invitesSent     Invite[]         @relation("InviteSender")
  logins          LoginEvent[]
  passwordResets  PasswordReset[]
  ledTeams        Team[]           @relation("TeamLead")
  teamMemberships TeamMember[]
  serviceRequests ServiceRequest[] @relation("Requester")

  @@index([companyId])
}

// An external customer company whose projects we deliver.
model Client {
  id           String   @id @default(cuid())
  companyId    String
  name         String
  contactEmail String?
  industry     String?
  createdAt    DateTime @default(now())

  company  Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  users    User[]
  projects Project[]
  invites  Invite[]
  requests ServiceRequest[]

  @@index([companyId])
}

model Project {
  id          String        @id @default(cuid())
  companyId   String
  clientId    String?
  managerId   String?
  teamId      String?
  name        String
  description String?
  status      ProjectStatus @default(PLANNING)
  startDate   DateTime?
  dueDate     DateTime?
  createdAt   DateTime      @default(now())

  company    Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  client     Client?         @relation(fields: [clientId], references: [id], onDelete: SetNull)
  manager    User?           @relation("ProjectManager", fields: [managerId], references: [id], onDelete: SetNull)
  team       Team?           @relation(fields: [teamId], references: [id], onDelete: SetNull)
  request    ServiceRequest?
  members    ProjectMember[]
  milestones Milestone[]
  tasks      Task[]
  activities Activity[]
  comments   Comment[]

  @@index([companyId])
  @@index([clientId])
}

model ProjectMember {
  projectId String
  userId    String
  addedAt   DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
}

model Milestone {
  id          String          @id @default(cuid())
  projectId   String
  title       String
  description String?
  dueDate     DateTime?
  status      MilestoneStatus @default(PENDING)
  clientNote  String?
  position    Int             @default(0)
  createdAt   DateTime        @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@index([projectId])
}

model Task {
  id            String     @id @default(cuid())
  projectId     String
  milestoneId   String?
  assigneeId    String?
  title         String
  description   String?
  status        TaskStatus @default(TODO)
  priority      Priority   @default(MEDIUM)
  estimateHours Float?
  dueDate       DateTime?
  position      Int        @default(0)
  completedAt   DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestone Milestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  assignee  User?      @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([projectId, status])
  @@index([assigneeId])
}

model Attendance {
  id         String           @id @default(cuid())
  companyId  String
  userId     String
  date       String // YYYY-MM-DD in the company's timezone
  checkIn    DateTime
  checkOut   DateTime?
  checkInLat Float?
  checkInLng Float?
  distanceM  Int?
  status     AttendanceStatus @default(PRESENT)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([companyId, date])
}

model Leave {
  id         String      @id @default(cuid())
  companyId  String
  userId     String
  type       LeaveType
  startDate  String // YYYY-MM-DD
  endDate    String // YYYY-MM-DD
  days       Int
  reason     String
  status     LeaveStatus @default(PENDING)
  reviewerId String?
  reviewNote String?
  createdAt  DateTime    @default(now())

  company  Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user     User    @relation("LeaveApplicant", fields: [userId], references: [id], onDelete: Cascade)
  reviewer User?   @relation("LeaveReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([companyId, status])
  @@index([userId])
}

// Audit/activity feed. `clientVisible` rows are shown on the client portal.
model Activity {
  id            String   @id @default(cuid())
  companyId     String
  projectId     String?
  actorId       String?
  message       String
  clientVisible Boolean  @default(false)
  createdAt     DateTime @default(now())

  company Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actor   User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
  @@index([projectId, createdAt])
}

// Project-level discussion shared between the team and the client.
model Comment {
  id        String   @id @default(cuid())
  projectId String
  authorId  String
  body      String
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author  User    @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
}

// Invitation to join a company. Only a SHA-256 hash of the token is stored;
// the raw token lives in the link we hand to the admin exactly once.
model Invite {
  id          String    @id @default(cuid())
  companyId   String
  email       String
  name        String?
  role        Role
  designation String?
  department  String?
  managerId   String? // who they will report to
  projectIds  String[] // projects they join as soon as they accept
  clientId    String? // for CLIENT invites: which client company they belong to
  tokenHash   String    @unique
  invitedById String?
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  client    Client? @relation(fields: [clientId], references: [id], onDelete: Cascade)
  invitedBy User?   @relation("InviteSender", fields: [invitedById], references: [id], onDelete: SetNull)

  @@index([companyId, acceptedAt])
}

// Every sign-in attempt, successful or not, for the admin security log.
model LoginEvent {
  id        String   @id @default(cuid())
  companyId String?
  userId    String?
  email     String
  success   Boolean
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([companyId, createdAt])
}

// One-time link to set a new password. Only the SHA-256 hash of the token is stored.
model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum EmailStatus {
  SENT // accepted by the SMTP server
  FAILED // SMTP rejected it
  OUTBOX // SMTP not configured; kept here so admins can still copy the link
}

// Every email the app sends (or would have sent), for the admin outbox.
model EmailLog {
  id        String      @id @default(cuid())
  companyId String?
  to        String
  subject   String
  html      String
  kind      String // invite | password_reset | welcome
  status    EmailStatus
  error     String?
  createdAt DateTime    @default(now())

  company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, createdAt])
}

// A delivery team (e.g. "Web", "Design"). The lead runs the team: members, services, tasks.
model Team {
  id               String   @id @default(cuid())
  companyId        String
  name             String
  tagline          String?
  description      String?
  color            String   @default("indigo")
  leadId           String?
  skills           String[]
  visibleToClients Boolean  @default(true)
  createdAt        DateTime @default(now())

  company  Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  lead     User?            @relation("TeamLead", fields: [leadId], references: [id], onDelete: SetNull)
  members  TeamMember[]
  services TeamService[]
  projects Project[]
  requests ServiceRequest[]

  @@unique([companyId, name])
}

model TeamMember {
  teamId  String
  userId  String
  addedAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([teamId, userId])
}

// Something a team offers clients, shown in the client portal.
model TeamService {
  id            String   @id @default(cuid())
  teamId        String
  title         String
  description   String
  deliverables  String[]
  turnaround    String? // e.g. "2-3 weeks"
  startingPrice Int? // in rupees
  position      Int      @default(0)
  createdAt     DateTime @default(now())

  team     Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  requests ServiceRequest[]

  @@index([teamId])
}

enum RequestStatus {
  NEW
  IN_REVIEW
  ACCEPTED
  DECLINED
  CONVERTED // turned into a project
}

// A client asking a team for work. Accepted requests become projects.
model ServiceRequest {
  id            String        @id @default(cuid())
  companyId     String
  clientId      String
  teamId        String
  serviceId     String?
  requestedById String?
  title         String
  details       String
  budget        String?
  deadline      DateTime?
  status        RequestStatus @default(NEW)
  response      String?
  projectId     String?       @unique
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  client      Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  team        Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  service     TeamService? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  requestedBy User?        @relation("Requester", fields: [requestedById], references: [id], onDelete: SetNull)
  project     Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([companyId, status])
  @@index([teamId])
}
