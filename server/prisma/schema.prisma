generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  EMPLOYEE
  CLIENT
}

enum AttendanceStatus {
  PRESENT
  LATE
}

enum LeaveType {
  CASUAL
  SICK
  EARNED
  UNPAID
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
}

enum MilestoneStatus {
  PENDING
  IN_PROGRESS
  AWAITING_APPROVAL
  APPROVED
  CHANGES_REQUESTED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// A tenant. Every other row belongs to exactly one company.
model Company {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  timezone      String   @default("Asia/Kolkata")
  workStartTime String   @default("10:00") // HH:mm, used to mark late check-ins
  officeLat     Float?
  officeLng     Float?
  officeRadiusM Int      @default(200)
  createdAt     DateTime @default(now())

  // Public profile, shown to clients browsing the directory once it is complete.
  tagline      String?
  about        String?
  industry     String?
  specialities String[]
  offerings    String[] // what the company can be hired for, in its own words
  website      String?
  city         String?
  country      String?
  foundedYear  Int?
  sizeRange    String? // e.g. "11-50"
  contactEmail String?
  isListed     Boolean  @default(false)

  users      User[]
  clients    Client[]
  projects   Project[]
  attendance Attendance[]
  leaves     Leave[]
  activities Activity[]
  invites    Invite[]
  logins     LoginEvent[]
  emails     EmailLog[]
  teams      Team[]
  requests   ServiceRequest[]
  proposals  Proposal[]
  meetings   Meeting[]
}

model User {
  id              String    @id @default(cuid())
  companyId       String? // null for clients: they belong to no company
  name            String
  email           String    @unique
  passwordHash    String
  role            Role
  designation     String?
  department      String?
  phone           String?
  isActive        Boolean   @default(true)
  joinedAt        DateTime  @default(now())
  managerId       String?
  organisation    String? // a client's own business, shown to companies
  bio             String?
  lastLoginAt     DateTime?
  // Owner of the WorkNest platform itself (sees every company). Never set via the API.
  isPlatformAdmin Boolean   @default(false)
  createdAt       DateTime  @default(now())

  company           Company?          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  manager           User?             @relation("Reports", fields: [managerId], references: [id], onDelete: SetNull)
  reports           User[]            @relation("Reports")
  clientRecords     Client[]          @relation("ClientAccount")
  needs             Need[]
  proposals         Proposal[]
  organisedMeetings Meeting[]         @relation("MeetingOrganiser")
  meetingSeats      MeetingAttendee[]
  managedProjects   Project[]         @relation("ProjectManager")
  memberships       ProjectMember[]
  assignedTasks     Task[]            @relation("TaskAssignee")
  attendance        Attendance[]
  leaves            Leave[]           @relation("LeaveApplicant")
  reviewedLeaves    Leave[]           @relation("LeaveReviewer")
  activities        Activity[]
  comments          Comment[]
  invitesSent       Invite[]          @relation("InviteSender")
  logins            LoginEvent[]
  passwordResets    PasswordReset[]
  ledTeams          Team[]            @relation("TeamLead")
  teamMemberships   TeamMember[]
  serviceRequests   ServiceRequest[]  @relation("Requester")

  @@index([companyId])
}

// A customer in one company's books. When the customer has a WorkNest client
// account, accountId links to it and their projects show up in their own portal.
model Client {
  id           String   @id @default(cuid())
  companyId    String
  accountId    String?
  name         String
  contactEmail String?
  industry     String?
  createdAt    DateTime @default(now())

  company  Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  account  User?            @relation("ClientAccount", fields: [accountId], references: [id], onDelete: SetNull)
  projects Project[]
  requests ServiceRequest[]

  @@index([companyId])
  @@index([accountId])
}

model Project {
  id          String        @id @default(cuid())
  companyId   String
  clientId    String?
  managerId   String?
  teamId      String?
  name        String
  description String?
  status      ProjectStatus @default(PLANNING)
  startDate   DateTime?
  dueDate     DateTime?
  createdAt   DateTime      @default(now())

  company    Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  client     Client?         @relation(fields: [clientId], references: [id], onDelete: SetNull)
  manager    User?           @relation("ProjectManager", fields: [managerId], references: [id], onDelete: SetNull)
  team       Team?           @relation(fields: [teamId], references: [id], onDelete: SetNull)
  request    ServiceRequest?
  members    ProjectMember[]
  milestones Milestone[]
  tasks      Task[]
  activities Activity[]
  comments   Comment[]

  @@index([companyId])
  @@index([clientId])
}

model ProjectMember {
  projectId String
  userId    String
  addedAt   DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
}

model Milestone {
  id          String          @id @default(cuid())
  projectId   String
  title       String
  description String?
  dueDate     DateTime?
  status      MilestoneStatus @default(PENDING)
  clientNote  String?
  position    Int             @default(0)
  createdAt   DateTime        @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@index([projectId])
}

model Task {
  id            String     @id @default(cuid())
  projectId     String
  milestoneId   String?
  assigneeId    String?
  title         String
  description   String?
  status        TaskStatus @default(TODO)
  priority      Priority   @default(MEDIUM)
  estimateHours Float?
  dueDate       DateTime?
  position      Int        @default(0)
  completedAt   DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestone Milestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  assignee  User?      @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([projectId, status])
  @@index([assigneeId])
}

model Attendance {
  id         String           @id @default(cuid())
  companyId  String
  userId     String
  date       String // YYYY-MM-DD in the company's timezone
  checkIn    DateTime
  checkOut   DateTime?
  checkInLat Float?
  checkInLng Float?
  distanceM  Int?
  status     AttendanceStatus @default(PRESENT)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([companyId, date])
}

model Leave {
  id         String      @id @default(cuid())
  companyId  String
  userId     String
  type       LeaveType
  startDate  String // YYYY-MM-DD
  endDate    String // YYYY-MM-DD
  days       Int
  reason     String
  status     LeaveStatus @default(PENDING)
  reviewerId String?
  reviewNote String?
  createdAt  DateTime    @default(now())

  company  Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user     User    @relation("LeaveApplicant", fields: [userId], references: [id], onDelete: Cascade)
  reviewer User?   @relation("LeaveReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([companyId, status])
  @@index([userId])
}

// Audit/activity feed. `clientVisible` rows are shown on the client portal.
model Activity {
  id            String   @id @default(cuid())
  companyId     String
  projectId     String?
  actorId       String?
  message       String
  clientVisible Boolean  @default(false)
  createdAt     DateTime @default(now())

  company Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actor   User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
  @@index([projectId, createdAt])
}

// Project-level discussion shared between the team and the client.
model Comment {
  id        String   @id @default(cuid())
  projectId String
  authorId  String
  body      String
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author  User    @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
}

// Invitation to join a company. Only a SHA-256 hash of the token is stored;
// the raw token lives in the link we hand to the admin exactly once.
model Invite {
  id          String    @id @default(cuid())
  companyId   String
  email       String
  name        String?
  role        Role
  designation String?
  department  String?
  managerId   String? // who they will report to
  projectIds  String[] // projects they join as soon as they accept
  tokenHash   String    @unique
  invitedById String?
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invitedBy User?   @relation("InviteSender", fields: [invitedById], references: [id], onDelete: SetNull)

  @@index([companyId, acceptedAt])
}

// Every sign-in attempt, successful or not, for the admin security log.
model LoginEvent {
  id        String   @id @default(cuid())
  companyId String?
  userId    String?
  email     String
  success   Boolean
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([companyId, createdAt])
}

// One-time link to set a new password. Only the SHA-256 hash of the token is stored.
model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum EmailStatus {
  SENT // accepted by the SMTP server
  FAILED // SMTP rejected it
  OUTBOX // SMTP not configured; kept here so admins can still copy the link
}

// Every email the app sends (or would have sent), for the admin outbox.
model EmailLog {
  id        String      @id @default(cuid())
  companyId String?
  to        String
  subject   String
  html      String
  kind      String // invite | password_reset | welcome
  status    EmailStatus
  error     String?
  createdAt DateTime    @default(now())

  company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, createdAt])
}

// A delivery team (e.g. "Web", "Design"). The lead runs the team: members, services, tasks.
model Team {
  id               String   @id @default(cuid())
  companyId        String
  name             String
  tagline          String?
  description      String?
  color            String   @default("indigo")
  leadId           String?
  skills           String[]
  visibleToClients Boolean  @default(true)
  createdAt        DateTime @default(now())

  company   Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  lead      User?            @relation("TeamLead", fields: [leadId], references: [id], onDelete: SetNull)
  members   TeamMember[]
  services  TeamService[]
  projects  Project[]
  requests  ServiceRequest[]
  proposals Proposal[]

  @@unique([companyId, name])
}

model TeamMember {
  teamId  String
  userId  String
  addedAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([teamId, userId])
}

// Something a team offers clients, shown in the client portal.
model TeamService {
  id            String   @id @default(cuid())
  teamId        String
  title         String
  description   String
  deliverables  String[]
  turnaround    String? // e.g. "2-3 weeks"
  startingPrice Int? // in rupees
  position      Int      @default(0)
  createdAt     DateTime @default(now())

  team     Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  requests ServiceRequest[]

  @@index([teamId])
}

enum RequestStatus {
  NEW
  IN_REVIEW
  ACCEPTED
  DECLINED
  CONVERTED // turned into a project
}

// A client asking a team for work. Accepted requests become projects.
model ServiceRequest {
  id            String        @id @default(cuid())
  companyId     String
  clientId      String
  teamId        String
  serviceId     String?
  requestedById String?
  title         String
  details       String
  budget        String?
  deadline      DateTime?
  status        RequestStatus @default(NEW)
  response      String?
  projectId     String?       @unique
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  client      Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  team        Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  service     TeamService? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  requestedBy User?        @relation("Requester", fields: [requestedById], references: [id], onDelete: SetNull)
  project     Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  proposal    Proposal?

  @@index([companyId, status])
  @@index([teamId])
}

enum NeedStatus {
  OPEN
  CLOSED
}

// Something a client is looking for. Every listed company can see open needs and respond.
model Need {
  id        String     @id @default(cuid())
  clientId  String
  title     String
  details   String
  category  String?
  budget    String?
  deadline  DateTime?
  status    NeedStatus @default(OPEN)
  createdAt DateTime   @default(now())

  client    User       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  proposals Proposal[]

  @@index([status, createdAt])
  @@index([clientId])
}

enum ProposalStatus {
  PENDING
  ACCEPTED
  DECLINED
}

// A company's answer to a client's need. Accepting it opens a request with the chosen team.
model Proposal {
  id        String         @id @default(cuid())
  needId    String
  companyId String
  teamId    String
  authorId  String?
  message   String
  status    ProposalStatus @default(PENDING)
  requestId String?        @unique
  createdAt DateTime       @default(now())

  need    Need            @relation(fields: [needId], references: [id], onDelete: Cascade)
  company Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  team    Team            @relation(fields: [teamId], references: [id], onDelete: Cascade)
  author  User?           @relation(fields: [authorId], references: [id], onDelete: SetNull)
  request ServiceRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)

  @@unique([needId, companyId])
  @@index([companyId])
}

// A meeting between people inside one company. Notes are written during or after it,
// and the summary (with decisions and action items) is produced from those notes.
model Meeting {
  id           String    @id @default(cuid())
  companyId    String
  organiserId  String?
  title        String
  agenda       String?
  startsAt     DateTime
  durationMin  Int       @default(30)
  joinUrl      String? // video call link; generated when the organiser doesn't supply one
  notes        String?
  summary      String?
  decisions    String[]
  actionItems  Json? // [{ owner, task, due }]
  summaryMode  String? // "ai" or "basic": how the summary was produced
  summarisedAt DateTime?
  createdAt    DateTime  @default(now())

  company   Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  organiser User?             @relation("MeetingOrganiser", fields: [organiserId], references: [id], onDelete: SetNull)
  attendees MeetingAttendee[]

  @@index([companyId, startsAt])
}

model MeetingAttendee {
  meetingId String
  userId    String

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([meetingId, userId])
  @@index([userId])
}
